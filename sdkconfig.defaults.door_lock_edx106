# ===========================================================================
# door_lock_edx106（demo 5.5）专用默认配置
#   覆盖工程级 sdkconfig.defaults + sdkconfig.defaults.esp32c6
# ===========================================================================
# 目的：让 USB（原生 USB Serial/JTAG）这一端**只有** `EDX106: ...` 协议行，
#       一个日志字符都不混进去 —— 因为本 demo 的 USB 流是被上位机/网页逐行解析
#       的文本协议，混入日志只会制造"坏行"，不会给出任何明确错误。
#
# 与 5.2/5.3/5.4（三个透传桥）的关系：
#   结构一致（同一套"静默保险"），但**理由不同**：
#     · 前三个桥怕的是"污染二进制/文本混流"；
#     · 本 demo 怕的是"污染命令与事件的文本协议"，以及日志里那些中文/板名
#       会让解析器把一行 `EDX106: ...` 拆坏。
#   另有一处实质差别：本 demo **同时要收命令**，所以 USB 驱动必须装起来
#   （固件里 `usb_serial_jtag_driver_install`），不能只当"只输出"用。
#
# !! 语法限制（踩过坑，见 docs/EDK60-pitfalls.md A3）!!
#    本文件只支持 KEY=VALUE 形式，**不支持行尾注释**：
#        CONFIG_LOG_DEFAULT_LEVEL_NONE=y   # 静默
#    这种写法会让整行被静默忽略（不报错！）。注释必须独占一行。
#
# !! 绝对不要改成"关闭 USB 第二控制台"!!
#    CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
#    后果不只是没输出：实测（2026-10-15）固件启动直接卡死，USB 不再枚举，
#    必须物理断电重插。而对本 demo 更致命 —— USB 就是它**唯一**的上报与命令
#    通道，关掉等于 demo 不存在。固件源码里有 #error 专门拦这一条。
# ===========================================================================

# ---------------------------------------------------------------------------
# 1) 数据流洁净第一道保险：把日志在**编译期**消掉
#    CONFIG_LOG_DEFAULT_LEVEL_NONE=y 后，ESP_LOG* 宏被编译成空语句。
#    （本 demo 源码本身通篇不用 ESP_LOG/printf，只用 usb_line() 直接写 USB，
#      所以这一项是"双保险"，不是唯一依赖。）
# ---------------------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_NONE=y

# ---------------------------------------------------------------------------
# 2) bootloader 阶段的日志不受 CONFIG_LOG_DEFAULT_LEVEL 管，必须单独关。
#    2026-10-23 上板实测：开机首帧出现过
#      "I (115) esp_image: segment 3: ... EasyDetek"
#    它会把纯文本协议打上第一行"坏行"。
# ---------------------------------------------------------------------------
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# ---------------------------------------------------------------------------
# 3) 关掉启动横幅与引脚表：两者都是 printf（不走 ESP_LOG），会把中文板名、
#    复位原因、引脚表整段写进 USB 数据流。本 demo 自己已经用一行
#      EDX106: start scl=.. sda=.. out=.. thr=.. delay=.. lockout=.. mode=..
#    给出了更完整的参数快照，横幅在这里只剩污染风险。
#    （demo_dispatch.c 的"洁净门禁"里也把本 demo 加进了跳过名单 —— 双保险。）
# ---------------------------------------------------------------------------
# CONFIG_APP_EDK60_STARTUP_BANNER is not set
# CONFIG_APP_EDK60_PRINT_PINMAP is not set

# ---------------------------------------------------------------------------
# 4) 本 demo 的静默开关必须与上面几项一致（固件里有 #error 交叉校验：
#    开了 SILENT_LOGS 却没关日志级别，构建会直接失败并给出修法）。
# ---------------------------------------------------------------------------
CONFIG_APP_EDK60_EDX106_SILENT_LOGS=y

# ---------------------------------------------------------------------------
# 5) 显式写出核心参数（值等于 Kconfig 默认值，写在这里是为了"配置意图可读"，
#    评审时能一眼对照 docs/project/edx106/firmware-implementation-notes.md）。
#
#    ⚠ I2C 频率 = 100000（不是 400000）：样机阶段用户没有 4.7k/10k 电阻，
#      整条总线只有 C6 内部上拉（~45 kΩ 量级），400 kHz 下上升沿不达标会 NACK。
#      固件在 probe 失败时会逐级降到 100 kHz / 50 kHz 并打印实际用的频率。
#      量产补上 H3 侧 2×4.7 kΩ 后，把这一行改回 400000（芯片上限）。
#
#    ⚠ 这三个寄存器控制位对应的 Kconfig 项**没有**开关：0x45 bit0=1、
#      0x6e bit6=1、0x6c bit6=1 在源码里是硬编码 + _Static_assert 钉死的
#      （缺一位就会静默退回模组内部绑定的 pin，是最难查的一类故障）。
#      这里只能改它们的"值"（延时/阈值/闭锁/功耗档），不能关掉"走寄存器"这件事。
# ---------------------------------------------------------------------------
CONFIG_APP_EDK60_EDX106_I2C_FREQ_HZ=100000
CONFIG_APP_EDK60_EDX106_SCL_GPIO=4
CONFIG_APP_EDK60_EDX106_SDA_GPIO=5
CONFIG_APP_EDK60_EDX106_OUT_GPIO=2
# Plan B：若上电偶发异常（IO2 是 strapping 关注脚），把上面 OUT_GPIO 改成 3
# （H3 的 A3，非 strapping、同属 EXT1 域），并把模组 OUT 线挪到 A3。详见 notes §10。
CONFIG_APP_EDK60_EDX106_OUT_ACTIVE_HIGH=y
CONFIG_APP_EDK60_EDX106_DELAY_MS=2000
CONFIG_APP_EDK60_EDX106_LOCKOUT_MS=2000
# 阈值 70：2026-10-18 用户现场定稿（300 要贴很近；115 → 约 30 cm；70 是用户在线
# `SET thr=70` 回读 rd=70 通过后确认的值）。Kconfig 的 default 也是 70 —— **两处必须一致**，
# 否则重新生成 sdkconfig 时会跳回旧值。
# 现场若仍不够，先 `SET thr=60` / `SET thr=40` 在线试，定了再同步改这两处。
CONFIG_APP_EDK60_EDX106_THRESHOLD=70
# ---------------------------------------------------------------------------
#    ⚠ 功耗模式：**Kconfig 默认是 y（ULP，产品默认）**，本 demo 级覆盖写 n（常规模式）。
#      两处默认**故意不一致**，理由如下（别当成笔误）：
#        · Kconfig 的 default y = **产品默认**（电池门锁，续航优先）；
#        · 本文件的 n       = **现场调距用的调试默认**（探测距离优先）。
#      现场实测结论：ULP 是 burst / duty-cycle 扫描（功耗 78~341 µA），
#      探测距离被大幅压缩；常规模式 ~26 mA，距离最远。
#      ⇒ 现场调距阶段先用常规模式确认**最大探测距离**；定型后再按功耗预算
#        决定是否切回 ULP（改这里一行，或运行期 `SET mode=ulp` 立刻对比）。
# ---------------------------------------------------------------------------
CONFIG_APP_EDK60_EDX106_ULP_MODE=y
CONFIG_APP_EDK60_EDX106_LIGHT_OFF=y
CONFIG_APP_EDK60_EDX106_SELFCHECK_MS=3000
CONFIG_APP_EDK60_EDX106_STATS_SEC=10
CONFIG_APP_EDK60_EDX106_LED_ENABLE=y
# 橙灯跟随 OUT：y = 灯跟随 OUT 高电平（默认）；n = 触发后只闪 300 ms 就熄灭。
# 要改成"闪一下"，把下面那一行替换成 "CONFIG_APP_EDK60_EDX106_LED_FOLLOW_OUT=n"。
CONFIG_APP_EDK60_EDX106_LED_FOLLOW_OUT=y
