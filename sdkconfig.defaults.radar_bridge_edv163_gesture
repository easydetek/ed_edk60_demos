# ===========================================================================
# radar_bridge_edv163_gesture（demo 5.4）专用默认配置
#   覆盖工程级 sdkconfig.defaults + sdkconfig.defaults.esp32c6
# ===========================================================================
# 目的：让 USB 那一端只有 EDV163 挥手识别模组的原始字节流
#       （**文本 GESTURE: 行 + 偶发 0x4544 二进制点云帧**），
#       一个日志字符都不混进去。
# 本文件只写「与其它 18 个 demo 不同」的那几行，其余全部沿用工程默认。
#
# 与 5.3（sdkconfig.defaults.radar_bridge_edv163）的关系：
#   结构完全一致（同一套「四道静默保险」），只有两处实质差别：
#     ① 波特率 **115200**（挥手固件 163_action_20260901）而不是 256000（水位）；
#     ② 符号前缀由 APP_EDK60_EDV163_* 换成 APP_EDK60_EDV163_GESTURE_*。
#   其余（静默 / 关闭横幅与引脚表 / 不关 USB 第二控制台）一字不改 ——
#   那几条都是上板实测过的结论，换模组/换固件不改变它们成立的理由。
#
# 为什么本 demo 对「洁净」的要求比前三个 demo 更高：
#   本流的主体是**没有校验、没有长度字段的文本行**。日志混进去不会造成
#   「校验失败」这种明确信号，只会让 `GESTURE:` 行变成认不出的坏行 ——
#   现场表现是「挥手方向偶尔不显示」。同时横幅里的板名以 0x45 0x44 开头，
#   正好等于二进制点云帧的帧头，会让上位机按垃圾长度字段乱跳。
#
# !! 语法限制（踩过坑，见 docs/EDK60-pitfalls.md A3）!!
#    本文件只支持 KEY=VALUE 形式，**不支持行尾注释**：
#        CONFIG_LOG_DEFAULT_LEVEL_NONE=y   # 静默
#    这种写法会让整行被静默忽略（不报错！）。注释必须独占一行。
#
# !! 绝对不要改成「关闭 USB 第二控制台」!!
#    CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
#    实测（2026-10-15）后果：固件启动卡死在
#        I (238) sleep_gpio: Enable automatic switching of GPIO sleep configuration
#    连 main_task 都不启动，USB 不再枚举，必须物理断电重插才能恢复。
#    根因：该选项与 USJ_ENABLE_USB_SERIAL_JTAG 联动，两个控制台都从 USB 撤掉后
#    USB 外设时钟在启动阶段被关死。
#    完整记录见 sdkconfig.defaults.radar_bridge 文件头与 docs/EDK60-pitfalls.md D1；
#    demo 源码里另有编译期断言直接拦住这一条。
# ===========================================================================

# ---------------------------------------------------------------------------
# 1) 数据流洁净的第一道保险：把日志在**编译期**消掉
#    CONFIG_LOG_DEFAULT_LEVEL_NONE=y 后，ESP_LOG* 宏被编译成空语句，一个字符都不写。
#
#    为什么不能只靠「运行时调低日志级别」：本项目实测过，单设本项仍然挡不住
#    printf —— radar_bridge 的实测记录里抓到 1142 字节控制台文本（启动横幅、
#    引脚表都是 printf）。所以本 demo 额外把这两处 printf 也关掉（见下面第 2 条），
#    并且 demo 源码里通篇不使用 printf / ESP_LOGx。
# ---------------------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_NONE=y

# ---------------------------------------------------------------------------
# 2) 关掉启动横幅与引脚表（两者都是 printf，且横幅里的板名以两个 ASCII 字节
#    "E""D" 开头 —— 正好等于二进制点云帧帧头 0x45 0x44，会被上位机当成一帧的
#    开头：假同步）。这两项在 demo 5.4 下没有任何诊断价值（诊断请用 UART0 开关）。
# ---------------------------------------------------------------------------
# CONFIG_APP_EDK60_STARTUP_BANNER is not set
# CONFIG_APP_EDK60_PRINT_PINMAP is not set

# ---------------------------------------------------------------------------
# 3) 串口参数：挥手固件（163_action_20260901）**115200** 8N1、无流控。
#    ⚠ 不是 256000（5.3 水位）、也不是 921600（5.2 EDV11P）。三档互不通用。
#      波特率错一档的典型现象是「一个字节都收不到」（帧错误让驱动整体丢字节，
#      见 pitfalls E2），而不是「收到乱码」——上板先数「每秒几行 GESTURE:」。
#    引脚（RX=IO4 / TX=IO5 / EN=IO14）在 BSP 里已用静态断言锁死，
#    这里不需要、也不应该再写，避免出现「两处配置谁说了算」的歧义。
#
#    顺带记录缓冲算式（对应 Kconfig 默认值，改这里必须同步改源码里的断言注释）：
#      UART_RX_BUF 16384 B ÷ 11520 B/s = 1422 ms ≥ 2×60 ms（USB 写预算）⇒ 23.7×
#      1024 B 只有 88 ms < 120 ms，会被源码末尾的编译期断言拦下（最小可用 2048 B）
# ---------------------------------------------------------------------------
CONFIG_APP_EDK60_EDV163_GESTURE_BAUD=115200

# ---------------------------------------------------------------------------
# 4) 显式声明本 demo 的控制台策略选择（与源码注释一一对应，便于评审对照）：
#    初始化后彻底静默；不做任何 UART0 直写调试输出。
#    需要临时上板排查时，改为：
#      CONFIG_APP_EDK60_EDV163_GESTURE_UART0_DEBUG=y
#    并且用完**务必改回来**。
# ---------------------------------------------------------------------------
CONFIG_APP_EDK60_EDV163_GESTURE_SILENT_LOGS=y
# CONFIG_APP_EDK60_EDV163_GESTURE_UART0_DEBUG is not set
# CONFIG_APP_EDK60_EDV163_GESTURE_STATS_VIA_USB is not set
