# ===========================================================================
# radar_bridge（demo 5.1）专用默认配置 —— 覆盖工程级 sdkconfig.defaults
# ===========================================================================
# 目的：让 USB 串口上尽量只有雷达数据。本文件记录两次实测的结论。
#
# ---------------------------------------------------------------------------
# ❌ 已验证不可行的方案 1：关闭「控制台第二输出口 = USB」
#       CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
#   实测（2026-10-15，EDK60 / ESP32-C6 / IDF v6.1）：
#     · 固件烧入后**系统启动直接卡死**：日志停在
#         I (238) sleep_gpio: Enable automatic switching of GPIO sleep configuration
#       之后再无输出（连 main_task 都不启动），USB 口不再枚举，
#       **必须物理断电重插**才能恢复。
#     · 对照：同一块板烧 hello_board（该选项保持开启）完全正常。
#   原因：`CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG` 会 select
#         `USJ_ENABLE_USB_SERIAL_JTAG`（见 esp_driver_usb_serial_jtag/Kconfig，
#         默认 y）。两个控制台都从 USB 撤掉后该模块的时钟在启动时被关，
#         随后系统初始化卡住。
#
# ❌ 已验证不完整的方案 2：只把日志级别设为 NONE
#       CONFIG_LOG_DEFAULT_LEVEL_NONE=y
#   实测：这**只压住 ESP_LOG***，而 demo 里的 printf（横幅、引脚表、识别结果）
#   仍然经控制台 → 仍然写到 USB 上（实测抓到 1142 字节控制台文本）。
#
# ---------------------------------------------------------------------------
# ✅ 当前阶段：先保证「能正常启动 + 能看诊断」，把清洁度放第二位
# ---------------------------------------------------------------------------
#   本文件暂时**不覆盖任何选项**（全部沿用工程默认：UART0 主控制台 +
#   USB 第二输出口 + INFO 日志），这样启动路径与 hello_board 完全一致，
#   可以正常看到雷达引脚/波特率自动识别的结果。
#
#   等链路确认可用后，再按需启用下面的「清洁模式」：
#     把 CONFIG_LOG_DEFAULT_LEVEL_NONE=y 打开，并在 demo 里把 printf 也改走日志
#     （或 freopen stdout 到 /dev/null），即可让 USB 上只剩数据。
# ===========================================================================

# 清洁模式（确认链路可用后再打开；打开后看不到任何诊断信息）
# CONFIG_LOG_DEFAULT_LEVEL_NONE=y

# ---------------------------------------------------------------------------
# 2026-10-15 上板实测得到的确定结论（已写死，不再靠自动识别）
#   · 电源使能 EN = IO14（拉高上电，红灯亮）；IO15 只驱动橙灯指示；
#   · 模组插在 H3 时，数据线 = IO4（H3 的 T 脚）；
#   · 波特率 = 921600（实测数据帧头 5A 0F 00 + "radar_read..."）。
#
# 关掉自动识别的原因：扫描会把悬空脚（如 IO3）的噪声当成“有数据”，
# 它的字节数可能反而比真实信号多，导致判错脚。
# 确定了就写死，启动更快也更稳。
# ---------------------------------------------------------------------------
CONFIG_APP_EDK60_BRIDGE2_RX_PIN=4
CONFIG_APP_EDK60_BRIDGE2_BAUD=921600
# CONFIG_APP_EDK60_BRIDGE2_AUTODETECT is not set

# 关闭本地回环自测：避免上位机发的字符被回显、混进雷达数据流
# CONFIG_APP_EDK60_BRIDGE2_LOCAL_ECHO is not set
