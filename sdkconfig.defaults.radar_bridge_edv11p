# ===========================================================================
# radar_bridge_edv11p（demo 5.2）专用默认配置 —— 覆盖工程级 sdkconfig.defaults
# ===========================================================================
# 目的：让 USB 那一端只有雷达的二进制字节流，一个日志字符都不混进去。
# 本文件只写「与其它 16 个 demo 不同」的那几行，其余全部沿用工程默认。
#
# !! 语法限制（踩过坑，见 docs/EDK60-pitfalls.md A3）!!
#    本文件只支持 KEY=VALUE 形式，**不支持行尾注释**：
#        CONFIG_LOG_DEFAULT_LEVEL_NONE=y   # 静默
#    这种写法会让整行被静默忽略（不报错！）。注释必须独占一行。
#
# !! 绝对不要改成「关闭 USB 第二控制台」!!
#    CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
#    实测（2026-10-15）后果：固件启动卡死在
#        I (238) sleep_gpio: Enable automatic switching of GPIO sleep configuration
#    连 main_task 都不启动，USB 不再枚举，必须物理断电重插才能恢复。
#    根因：该选项与 USJ_ENABLE_USB_SERIAL_JTAG 联动，两个控制台都从 USB 撤掉后
#    USB 外设时钟在启动阶段被关死。
#    完整记录见 sdkconfig.defaults.radar_bridge 文件头与 docs/EDK60-pitfalls.md D1；
#    demo 源码里另有编译期断言直接拦住这一条。
# ===========================================================================

# ---------------------------------------------------------------------------
# 1) 数据流洁净的第一道保险：把日志在**编译期**消掉
#    CONFIG_LOG_DEFAULT_LEVEL_NONE=y 后，ESP_LOG* 宏被编译成空语句，一个字符都不写。
#
#    为什么不能只靠「运行时调低日志级别」：本项目实测过，单设本项仍然挡不住
#    printf —— radar_bridge 的实测记录里抓到 1142 字节控制台文本（启动横幅、
#    引脚表都是 printf）。所以本 demo 额外把这两处 printf 也关掉（见下面第 2 条），
#    并且 demo 源码里通篇不使用 printf / ESP_LOGx。
# ---------------------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_NONE=y

# ---------------------------------------------------------------------------
# 2) 关掉启动横幅与引脚表（两者都是 printf，且横幅里的板名以两个 ASCII 字节
#    "E""D" 开头 —— 正好等于雷达帧头，会被上位机当成一帧的开头：假同步）。
#    这两项在 demo 5.2 下没有任何诊断价值（诊断请用 UART0 调试开关）。
# ---------------------------------------------------------------------------
# CONFIG_APP_EDK60_STARTUP_BANNER is not set
# CONFIG_APP_EDK60_PRINT_PINMAP is not set

# ---------------------------------------------------------------------------
# 3) 串口参数：EDV11P 实测/手册值 921600 8N1、无流控。
#    引脚（RX=IO4 / TX=IO5 / EN=IO14）在 BSP 里已用静态断言锁死，
#    这里不需要、也不应该再写，避免出现「两处配置谁说了算」的歧义。
# ---------------------------------------------------------------------------
CONFIG_APP_EDK60_EDV11P_BAUD=921600

# ---------------------------------------------------------------------------
# 4) 显式声明本 demo 的控制台策略选择（与源码注释一一对应，便于评审对照）：
#    初始化后彻底静默；不做任何 UART0 直写调试输出。
# ---------------------------------------------------------------------------
CONFIG_APP_EDK60_EDV11P_SILENT_LOGS=y
# CONFIG_APP_EDK60_EDV11P_UART0_DEBUG is not set
